@@ -0,0 +1,41 @@
+namespace Zava.Integrations.Account.Plugins
+{
+    using Microsoft.Xrm.Sdk;
+    using Vela.Context;
+    using Vela.DI;
+    using Vela.Plugin;
+    using Zava.Integrations.Account.Services;
+    using Zava.Shared.Models.Generated;
+
+    /// <summary>Plugin generated by <c>vela add plugin</c>.</summary>
+    public sealed partial class AccountErpNotify(string unsecureConfig, string secureConfig) : EntityPluginBase<Account>(unsecureConfig, secureConfig)
+    {
+        protected override void RegisterPluginSteps()
+        {
+            RegisterStep().OnCreate()
+                .PostOperation()
+                .Async(deleteJobOnSuccess: true)
+                .FilterOn(e => e.Name)
+                .WithSecureConfigFrom("ErpApiKey")
+                .WithDescription("Sends the new account (id, name) to the ERP.")
+                .Handle(OnExecute);
+        }
+
+        protected override void ConfigureServices(SimpleServiceResolver services, ILocalPluginContext context)
+            => services.AddScoped<IErpAccountSender>(r => new ErpAccountSender(SecureConfig));
+
+        private void OnExecute(ICreatePostContext<Account> ctx)
+        {
+            ctx.Trace("AccountErpNotify: sending {0} '{1}' to the ERP.", ctx.PrimaryEntityName, ctx.PrimaryEntityId);
+
+            if (string.IsNullOrWhiteSpace(SecureConfig))
+            {
+                throw new InvalidPluginExecutionException(
+                    "The ERP API key is not configured: set the step's secure configuration 'ErpApiKey'.");
+            }
+
+            ctx.GetRequiredService<IErpAccountSender>().Send(ctx.PrimaryEntityId, ctx.Request.Target.Name);
+            ctx.Trace("AccountErpNotify: ERP accepted account '{0}'.", ctx.PrimaryEntityId);
+        }
+    }
+}
